    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message || {};\nconst text = msg.text || \"\";\n\nlet context = \"General Notes\";\nlet rawNotes = text;\n\nconst contextMatch = text.match(/Context:\\s*(.+)/i);\nconst notesMatch = text.match(/Notes:\\s*([\\s\\S]+)/i);\n\nif (contextMatch) context = contextMatch[1].trim();\nif (notesMatch) rawNotes = notesMatch[1].trim();\n\nconst rawWordCount = rawNotes.split(/\\s+/).filter(Boolean).length;\n\nreturn [{\n  json: {\n    chat_id: msg.chat?.id || \"\",\n    context,\n    raw_notes: rawNotes,\n    raw_word_count: rawWordCount\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "81a2ab90-3567-4a6d-ba4e-f31d1259561f",
      "name": "Parse Input"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a context-aware technical editor and data structurer.\nContext: {{ $json.context }}\nRaw Messy Notes: {{ $json.raw_notes }}\n\nRules:\n1. Rewrite the messy notes into a clean, high-readability summary tailored specifically to the given Context using clear headings and bullet points. Do not invent facts not present in the notes.\n2. Extract structured metadata.\n\nReturn ONLY valid JSON in this exact format:\n{\n  \"clean_summary\": \"string\",\n  \"urgency\": \"Low | Medium | High\",\n  \"action_items_count\": 0\n}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        448,
        0
      ],
      "id": "d58d78ef-6335-4847-bf90-6bda0a38e225",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        384,
        208
      ],
      "id": "3dd57435-c0fc-47fc-8bc0-5957c593f7ee",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "Mrb7E1i1XxqcKHNf",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Parse Input').first().json;\nlet llmText = $input.first().json.text || $input.first().json.output || \"\";\n\nllmText = llmText.replace(/```json\\s*/gi, \"\").replace(/```\\s*/g, \"\").trim();\n\nconst parsed = JSON.parse(llmText);\nconst cleanSummary = parsed.clean_summary || \"\";\nconst summaryWordCount = cleanSummary.split(/\\s+/).filter(Boolean).length;\n\nreturn [{\n  json: {\n    chat_id: prev.chat_id,\n    context_type: prev.context,\n    urgency: parsed.urgency || \"Medium\",\n    action_items_count: Number(parsed.action_items_count) || 0,\n    raw_word_count: prev.raw_word_count,\n    summary_word_count: summaryWordCount,\n    clean_summary: cleanSummary\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
